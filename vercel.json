{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web-app && npm run build",
  "outputDirectory": "web-app/dist",
  "installCommand": "pip install -r api/requirements.txt && cd web-app && npm install",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "web-api/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/api", "destination": "/api" },
    { "source": "/health/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/((?!api(?:/|$)|health(?:/|$)).*)", "destination": "/index.html" }
  ]
}
