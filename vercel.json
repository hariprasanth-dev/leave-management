{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node web-app/scripts/sync-server-from-web-api.mjs && cd web-app && npm run build",
  "outputDirectory": "web-app/dist",
  "installCommand": "pip install -r api/requirements.txt && cd web-app && npm install",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "web-api/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/health/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
