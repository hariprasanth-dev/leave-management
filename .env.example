# Local default uses SQLite so Phase 3 works without Docker.
# For Postgres: postgresql+psycopg://leaveflow:leaveflow@localhost:5432/leaveflow
DATABASE_URL=sqlite+pysqlite:///./leaveflow.db
JWT_SECRET=dev-secret-change-me-in-production
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
AUTH_SERVICE_URL=http://localhost:8001
EMPLOYEE_SERVICE_URL=http://localhost:8002
LEAVE_SERVICE_URL=http://localhost:8003
APPROVAL_SERVICE_URL=http://localhost:8004
