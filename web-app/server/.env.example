# MUST be leave_management_api — the app does not use leave_management_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/leave_management_api
JWT_SECRET=dev-secret-change-me-in-production
ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:5173
AUTH_SERVICE_URL=http://127.0.0.1:8001
EMPLOYEE_SERVICE_URL=http://127.0.0.1:8002
LEAVE_SERVICE_URL=http://127.0.0.1:8003
APPROVAL_SERVICE_URL=http://127.0.0.1:8004

# Leave approve/reject emails to the employee's work address.
# Leave SMTP_HOST empty to skip sending (emails are only logged).
# Gmail/Google Workspace: smtp.gmail.com, port 587, STARTTLS, an App Password.
# Microsoft 365: smtp.office365.com, port 587, STARTTLS.
# Port 465 servers: SMTP_SSL=true and SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=LeaveFlow <no-reply@yourdomain.com>
