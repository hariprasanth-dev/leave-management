# Production (Vercel): set in Project → Environment Variables
# VITE_APP_ENV=production
# VITE_API_BASE_URL=https://leave-management-suev.onrender.com

# API gateway (LeaveFlow local default)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional static API key (leave empty for JWT-only auth)
VITE_API_KEY=

# Set true to force relative URLs through the Vite proxy instead of VITE_API_BASE_URL
VITE_USE_PROXY=false

# Feature switchers
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK=false
