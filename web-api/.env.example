# Supabase PostgreSQL — same schema as local DB `leave_management_api` (run alembic on Supabase).
# Supabase → Project Settings → Database (password) + Settings → General (region).
# Optional: paste full URI as DATABASE_URL instead of DATABASE_HOST + DATABASE_PASSWORD.
#
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_HOST=db.jfijejumpohkwgoxikye.supabase.co
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_NAME=postgres
DATABASE_SSLMODE=require
SUPABASE_REGION=ap-northeast-1
SUPABASE_USE_POOLER=true
DATABASE_PASSWORD=

# Render / production: set the same keys in the dashboard (plus JWT_SECRET, FRONTEND_URL).

JWT_SECRET=dev-secret-change-me-in-production
ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:5173
AUTH_SERVICE_URL=http://127.0.0.1:8001
EMPLOYEE_SERVICE_URL=http://127.0.0.1:8002
LEAVE_SERVICE_URL=http://127.0.0.1:8003
APPROVAL_SERVICE_URL=http://127.0.0.1:8004
